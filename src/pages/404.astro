---
import Base from "../layouts/Base.astro";
import Brand from "../components/ui/Brand.astro";
import { site } from "../data/site";
import { getContent } from "../i18n";

const pt = getContent("pt-BR").notFound;
const en = getContent("en").notFound;
const mailHref = `mailto:${site.email}`;

/**
 * GitHub Pages serves one 404.html for every missing path, including `/en/…`.
 * Both languages are in the document so either reader can recover.
 */
const languages = [
  { code: "pt-BR", copy: pt, href: "/" },
  { code: "en", copy: en, href: "/en/" },
] as const;
---

<Base
  locale="pt-BR"
  path="/404.html"
  title={`404 — ${pt.label} / ${en.label} | ${site.name}`}
  description={`${pt.description} ${en.description}`}
  noindex
>
  <main id="main" class="nf">
    <div class="ambient" aria-hidden="true">
      <div class="grid-lines"></div>
      <div
        class="blob"
        style="width: 32rem; height: 32rem; left: 20%; top: -8rem; background: radial-gradient(circle at 50% 50%, #3b5bdb, transparent 68%);"
      >
      </div>
    </div>

    <div class="shell nf-inner">
      <a href="/" class="nf-brand"><Brand href="/" /></a>

      <p class="eyebrow"><span class="idx">404</span></p>

      <div class="nf-langs">
        {
          languages.map((language, index) => (
            <article lang={language.code}>
              {index === 0 ? (
                <h1 class="display-2 nf-title">
                  {language.copy.title}
                  <br />
                  <span class="text-grad">{language.copy.accent}</span>
                </h1>
              ) : (
                <h2 class="display-2 nf-title">
                  {language.copy.title}
                  <br />
                  <span class="text-grad">{language.copy.accent}</span>
                </h2>
              )}
              <p class="lead nf-text">
                {language.copy.text} <a href={mailHref}>{site.email}</a>.
              </p>
              <a class:list={["btn", index === 0 ? "btn--primary" : "btn--ghost"]} href={language.href}>
                {language.copy.home}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </main>
</Base>

<style>
  .nf {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    overflow: hidden;
    padding-block: 4rem;
  }

  .nf-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .nf-brand {
    margin-bottom: 1rem;
  }

  .nf-langs {
    display: grid;
    gap: 2rem;
    width: min(100%, 68rem);
  }

  .nf-langs article {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }

  .nf-langs article + article {
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .nf-title {
    max-width: 18ch;
  }

  .nf-text {
    max-width: 46ch;
  }

  .nf-text a {
    color: var(--color-fg);
    border-bottom: 1px solid var(--color-line-strong);
  }

  @media (min-width: 800px) {
    .nf-langs {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }

    .nf-langs article + article {
      padding-top: 0;
      padding-left: 3rem;
      border-top: 0;
      border-left: 1px solid var(--color-line);
    }
  }
</style>

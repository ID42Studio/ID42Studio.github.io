---
import Base from "../layouts/Base.astro";
import Brand from "../components/ui/Brand.astro";
import { site } from "../data/site";
---

<Base
  locale="pt-BR"
  path="/404.html"
  title="404 — Página não encontrada | ID42 Studio"
  description="O endereço não existe ou mudou de lugar."
  noindex
>
  <main id="main" class="nf">
    <div class="ambient" aria-hidden="true">
      <div class="grid-lines"></div>
      <div
        class="blob"
        style="width: 32rem; height: 32rem; left: 20%; top: -8rem; background: radial-gradient(circle at 50% 50%, #3b5bdb, transparent 68%);"
      >
      </div>
    </div>

    <div class="shell nf-inner">
      <a href="/" class="nf-brand"><Brand href="/" /></a>

      <p class="eyebrow"><span class="idx">404</span><span>Não encontrado</span></p>
      <h1 class="display-2 nf-title">
        Esta página saiu do ar.<br />
        <span class="text-grad">O estúdio continua.</span>
      </h1>
      <p class="lead nf-text">
        O endereço não existe (ou mudou de lugar). Volte para a página inicial — ou fale direto com a
        gente em <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>

      <div class="nf-actions">
        <a class="btn btn--primary" href="/">Voltar para o início</a>
        <a class="btn btn--ghost" href="/en/">English version</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .nf {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    overflow: hidden;
    padding-block: 4rem;
  }

  .nf-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }

  .nf-brand {
    margin-bottom: 1rem;
  }

  .nf-title {
    max-width: 18ch;
  }

  .nf-text {
    max-width: 46ch;
  }

  .nf-text a {
    color: var(--color-fg);
    border-bottom: 1px solid var(--color-line-strong);
  }

  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1rem;
  }
</style>

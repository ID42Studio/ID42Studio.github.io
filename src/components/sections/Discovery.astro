---
import type { SiteContent } from "../../i18n";
import Icon from "../ui/Icon.astro";

interface Props {
  content: SiteContent["discovery"];
  mailHref: string;
}

const { content, mailHref } = Astro.props;
---

<section class="section section--line" id="discovery">
  <div class="shell">
    <div class="discovery" data-reveal>
      <div class="discovery-copy">
        <p class="eyebrow">
          <span class="idx">{content.index}</span>
          <span>{content.eyebrow}</span>
        </p>
        <h2 class="display-3 discovery-title">{content.title}</h2>
        <p class="discovery-text">{content.text}</p>

        <a class="btn btn--primary discovery-cta" href={mailHref}>
          {content.cta}
          <Icon name="arrowRight" size={16} />
        </a>
        <p class="discovery-note mono-label">{content.note}</p>
      </div>

      <div class="discovery-list">
        <p class="mono-label">{content.deliverablesLabel}</p>
        <ul>
          {content.deliverables.map((item) => (
            <li>
              <Icon name="check" size={13} strokeWidth={2} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .discovery {
    display: grid;
    gap: 2rem;
    padding: clamp(1.6rem, 3vw, 2.6rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 90% at 0% 0%, rgba(91, 124, 255, 0.1), transparent 55%),
      linear-gradient(180deg, #0b0b11, #08080c);
  }

  .discovery-copy {
    display: grid;
    gap: 1.1rem;
    align-content: start;
  }

  .discovery-title {
    max-width: 22ch;
  }

  .discovery-text {
    max-width: 52ch;
    color: var(--color-muted);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .discovery-cta {
    justify-self: start;
    margin-top: 0.4rem;
  }

  .discovery-note {
    color: var(--color-subtle);
  }

  .discovery-list {
    display: grid;
    gap: 0.85rem;
    align-content: start;
    padding-top: 0.25rem;
  }

  .discovery-list ul {
    display: grid;
    gap: 0.55rem;
  }

  .discovery-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-muted);
  }

  .discovery-list li svg {
    flex: none;
    margin-top: 0.2rem;
    color: var(--color-blue);
  }

  @media (min-width: 900px) {
    .discovery {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }

    .discovery-list {
      padding-top: 1.9rem;
    }
  }
</style>

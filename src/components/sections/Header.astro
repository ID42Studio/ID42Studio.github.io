---
import type { SiteContent, Locale } from "../../i18n";
import Brand from "../ui/Brand.astro";
import Icon from "../ui/Icon.astro";
import LocaleSwitch from "../ui/LocaleSwitch.astro";

interface Props {
  content: SiteContent;
  locale: Locale;
  ctaHref: string;
  homeHref: string;
}

const { content, locale, ctaHref, homeHref } = Astro.props;
const { nav, a11y } = content;
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <Brand href={homeHref} />

    <nav class="nav-desktop" aria-label={a11y.mainNav}>
      {nav.links.map((link) => (
        <a class="nav-link" href={link.href} data-nav-link>{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <LocaleSwitch locale={locale} label={a11y.language} />

      <a class="btn btn--primary btn--sm header-cta" href={ctaHref}>
        {nav.cta}
        <Icon name="arrowUpRight" size={14} />
      </a>

      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={a11y.menuOpen}
        data-menu-toggle
        data-label-open={a11y.menuOpen}
        data-label-close={a11y.menuClose}
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  <div class="scroll-progress" aria-hidden="true"><span data-scroll-progress></span></div>
</header>

<div class="mobile-menu" id="mobile-menu" inert data-menu role="dialog" aria-modal="true" aria-label={a11y.menu}>
  <nav aria-label={a11y.mobileNav}>
    {nav.links.map((link, i) => (
      <a class="mobile-link" href={link.href} data-menu-link>
        <span>{String(i + 1).padStart(2, "0")}</span>
        {link.label}
      </a>
    ))}
  </nav>

  <div class="mobile-foot">
    <a class="btn btn--primary" href={ctaHref}>{nav.cta}</a>
    <LocaleSwitch locale={locale} label={a11y.language} />
  </div>
</div>

<style>
  .header-cta {
    display: none;
  }

  @media (min-width: 640px) {
    .header-cta {
      display: inline-flex;
    }
  }
</style>

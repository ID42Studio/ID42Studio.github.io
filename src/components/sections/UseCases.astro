---
import type { SiteContent } from "../../i18n";
import SectionHead from "../ui/SectionHead.astro";
import Icon from "../ui/Icon.astro";
import Anchor from "../ui/Anchor.astro";

interface Props {
  content: SiteContent["useCases"];
}

const { content } = Astro.props;
---

<section class="section section--line" id="casos-de-uso">
  <Anchor name="applications" />
  <div class="shell">
    <SectionHead
      index={content.index}
      eyebrow={content.eyebrow}
      title={content.title}
      subtitle={content.subtitle}
    />

    <div class="usecase-grid">
      {content.groups.map((group, i) => (
        <article class="usecase" data-reveal style={`--d:${i}`}>
          <span class="usecase-icon"><Icon name={group.icon} size={20} /></span>
          <h3>{group.title}</h3>
          <p class="usecase-text">{group.text}</p>
          <ul>
            {group.items.map((item) => (
              <li>
                <Icon name="check" size={13} strokeWidth={2} />
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="usecase-deliverable">
            <span class="mono-label">{content.deliverableLabel}</span>
            {group.deliverable}
          </p>
        </article>
      ))}
    </div>

    <p class="usecase-note" data-reveal>{content.note}</p>
  </div>
</section>

<style>
  .usecase-grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
  }

  .usecase-text {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-subtle);
    text-wrap: pretty;
  }

  .usecase-deliverable {
    display: grid;
    gap: 0.35rem;
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-line);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-fg);
  }

  .usecase-note {
    margin-top: 1.6rem;
    max-width: 70ch;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-subtle);
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .usecase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

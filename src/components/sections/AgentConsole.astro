---
import type { SiteContent } from "../../i18n";
import Icon from "../ui/Icon.astro";

interface Props {
  content: SiteContent["hero"]["console"];
}

const { content } = Astro.props;
---

<div class="console" data-console>
  <div class="console-bar">
    <span class="console-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="console-title">{content.title}</span>
    <span class="console-status">
      <span class="dot-live" aria-hidden="true"></span>
      {content.status}
    </span>
  </div>

  <div class="console-tabs" role="group" aria-label={content.scenarioLabel}>
    {content.scenarios.map((scenario, index) => (
      <button
        type="button"
        class:list={["console-tab", { "is-active": index === 0 }]}
        data-scenario={scenario.id}
        aria-pressed={index === 0 ? "true" : "false"}
      >
        {scenario.label}
      </button>
    ))}
  </div>

  <div class="console-body">
    {content.scenarios.map((scenario, index) => (
      <div class="console-panel" data-panel={scenario.id} hidden={index !== 0}>
        <ol class="console-steps">
          {scenario.steps.map((step, stepIndex) => (
            <li class="console-step" data-step={stepIndex}>
              <span class="mark" aria-hidden="true">
                <Icon name="check" size={11} strokeWidth={2.4} />
              </span>
              <span class="label">{step.label}</span>
              <span class="detail">{step.detail}</span>
            </li>
          ))}
        </ol>

        <p class="console-result" data-result hidden>
          <span class="console-result-label">{content.resultLabel}</span>
          <span>{scenario.result}</span>
        </p>
      </div>
    ))}
  </div>

  <div class="console-foot">
    <button type="button" class="console-run" data-run>
      <span data-run-label data-idle={content.run} data-done={content.replay}>{content.run}</span>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h13"></path>
        <path d="M13 6l6 6-6 6"></path>
      </svg>
    </button>

    <span class="console-progress" aria-hidden="true"><i data-progress></i></span>

    <span class="console-note">{content.note}</span>
  </div>

  <p class="sr-only" aria-live="polite" data-console-live></p>
</div>

<style>
  .console {
    position: relative;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(180deg, rgba(17, 17, 25, 0.94) 0%, rgba(8, 8, 12, 0.97) 100%);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.06) inset,
      0 40px 120px -50px color-mix(in oklab, var(--color-blue) 80%, transparent);
    overflow: hidden;
    backdrop-filter: blur(6px);
  }

  .console::before {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 120px;
    background: radial-gradient(60% 100% at 50% 0%, rgba(91, 124, 255, 0.22), transparent 70%);
    pointer-events: none;
  }

  .console-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-subtle);
  }

  .console-dots {
    display: flex;
    gap: 5px;
  }

  .console-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
  }

  .console-title {
    color: var(--color-muted);
    letter-spacing: 0.04em;
  }

  .console-status {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-cyan);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.625rem;
  }

  .console-tabs {
    position: relative;
    display: flex;
    gap: 0.25rem;
    padding: 0.55rem 0.6rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  .console-tab {
    padding: 0.45rem 0.7rem;
    border-radius: 8px 8px 0 0;
    border: 1px solid transparent;
    border-bottom: 0;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-subtle);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .console-tab:hover {
    color: var(--color-fg);
  }

  .console-tab.is-active {
    color: var(--color-fg);
    background: rgba(255, 255, 255, 0.05);
    border-color: var(--color-line);
  }

  .console-body {
    position: relative;
    padding: 0.7rem;
  }

  .console-steps {
    display: grid;
    gap: 0.3rem;
  }

  .console-step {
    display: grid;
    grid-template-columns: 1.35rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.65rem;
    border-radius: 12px;
    border: 1px solid transparent;
    opacity: 0.35;
    transition: opacity 0.4s ease, background-color 0.4s ease, border-color 0.4s ease,
      transform 0.4s var(--ease-out-expo);
  }

  .console-step .mark {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    border: 1px solid var(--color-line-strong);
    color: var(--color-subtle);
    transition: color 0.4s ease, border-color 0.4s ease, background-color 0.4s ease;
  }

  .console-step .mark svg {
    width: 11px;
    height: 11px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .console-step .label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-fg);
    letter-spacing: -0.01em;
  }

  .console-step .detail {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--color-subtle);
    text-align: right;
    white-space: nowrap;
  }

  .console-step.is-done {
    opacity: 0.6;
  }

  .console-step.is-done .mark {
    border-color: color-mix(in oklab, var(--color-cyan) 45%, transparent);
    background: color-mix(in oklab, var(--color-cyan) 12%, transparent);
    color: var(--color-cyan);
  }

  .console-step.is-done .mark svg {
    opacity: 1;
  }

  .console-step.is-active {
    opacity: 1;
    border-color: color-mix(in oklab, var(--color-blue) 40%, transparent);
    background: color-mix(in oklab, var(--color-blue) 9%, transparent);
    transform: translateX(2px);
  }

  .console-step.is-active .mark {
    border-color: var(--color-blue);
    color: var(--color-blue);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-blue) 14%, transparent);
    background: transparent;
  }

  .console-step.is-active .mark svg {
    display: none;
  }

  .console-step.is-active .mark::after {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-blue);
    animation: pulse 1.4s ease-in-out infinite;
  }

  .console-result {
    margin: 0.25rem 0.3rem 0.15rem;
    padding: 0.7rem 0.75rem;
    border: 1px solid color-mix(in oklab, var(--color-cyan) 28%, transparent);
    border-radius: 12px;
    background: color-mix(in oklab, var(--color-cyan) 7%, transparent);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-fg);
    display: grid;
    gap: 0.2rem;
  }

  .console-result-label {
    font-family: var(--font-mono);
    font-size: 0.5625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-cyan);
  }

  .console-foot {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem 0.7rem;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    color: var(--color-subtle);
  }

  .console-run {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    color: var(--color-fg);
    background: rgba(255, 255, 255, 0.04);
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .console-run:hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: color-mix(in oklab, var(--color-blue) 55%, var(--color-line-strong));
  }

  .console-run[disabled] {
    opacity: 0.5;
    cursor: default;
  }

  .console-progress {
    flex: 1;
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    overflow: hidden;
  }

  .console-progress i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-blue), var(--color-cyan));
    transition: width 0.5s var(--ease-out-expo);
  }

  .console-note {
    white-space: nowrap;
    opacity: 0.8;
  }

  @media (max-width: 420px) {
    .console-note {
      display: none;
    }
  }
</style>

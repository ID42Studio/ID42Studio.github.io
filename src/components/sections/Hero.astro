---
import type { SiteContent } from "../../i18n";
import Icon from "../ui/Icon.astro";
import Anchor from "../ui/Anchor.astro";
import AgentConsole from "./AgentConsole.astro";

interface Props {
  content: SiteContent;
  mailHref: string;
}

const { content, mailHref } = Astro.props;
const { hero } = content;

/** Floating capability chips: order matches `hero.chips` in both locales. */
const chipPositions = [
  "right: -1rem; top: 3.5rem;",
  "left: -1.5rem; bottom: 4.5rem;",
  "right: 2rem; bottom: -1.2rem;",
];
const chipColors = ["#5b7cff", "#a78bfa", "#3de1ff"];
---

<section class="hero" id="top">
  <Anchor name="home" />

  <canvas class="hero-canvas" data-gl aria-hidden="true"></canvas>

  <div class="ambient" aria-hidden="true">
    <div class="grid-lines"></div>
    <div
      class="blob"
      style="width: 40rem; height: 40rem; left: -10rem; top: -12rem; background: radial-gradient(circle at 35% 35%, #2b4bff, transparent 68%);"
    >
    </div>
    <div
      class="blob"
      style="width: 34rem; height: 34rem; right: -8rem; top: -4rem; background: radial-gradient(circle at 55% 45%, #8b5cf6, transparent 68%); animation-delay: -9s;"
    >
    </div>
    <div
      class="blob"
      style="width: 26rem; height: 26rem; left: 45%; top: 26rem; background: radial-gradient(circle at 50% 50%, #0ea5e9, transparent 70%); opacity: .26; animation-delay: -14s;"
    >
    </div>
  </div>

  <div class="shell relative z-10">
    <div class="hero-head">
      <p class="eyebrow hero-in" style="--i: 0">
        <span class="dot-live" aria-hidden="true"></span>
        <span>{hero.eyebrow}</span>
      </p>

      <h1 class="display-1 hero-title">
        {hero.titleLines.map((line, i) => (
          <span class="hero-line" style={`--i:${i}`}>
            <span class={i === hero.accentLine ? "text-grad" : undefined}>{line}</span>
          </span>
        ))}
      </h1>
    </div>

    <div class="hero-body">
      <div class="hero-copy">
        <p class="lead hero-sub hero-in" style="--i: 3">{hero.subtitle}</p>

        <div class="hero-actions hero-in" style="--i: 4">
          <a class="btn btn--primary" href={mailHref}>
            {hero.primaryCta}
            <Icon name="arrowRight" size={16} />
          </a>
          <a class="btn btn--ghost" href={hero.secondaryHref}>{hero.secondaryCta}</a>
        </div>

        <p class="hero-support mono-label hero-in" style="--i: 5">{hero.support}</p>

        <div class="hero-proof hero-in" style="--i: 6">
          <span class="mono-label">{hero.proofLabel}</span>
          <ul class="proof-list">
            {hero.proof.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>

      <div class="hero-visual hero-in" style="--i: 3" data-hero-visual>
        <div class="console-slot">
          <AgentConsole content={hero.console} />
        </div>

        {hero.chips.map((chip, i) => (
          <span
            class={`chip-float chip-${["a", "b", "c"][i] ?? "a"}`}
            style={`--chip-color: ${chipColors[i] ?? "#5b7cff"}; ${chipPositions[i] ?? ""}`}
          >
            <i></i>{chip}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(7.25rem, 11vw, 9rem);
    padding-bottom: clamp(2.75rem, 5.5vw, 4.5rem);
  }

  .hero-head {
    display: grid;
    gap: 1.35rem;
  }

  .hero-in {
    opacity: 0;
    transform: translateY(14px);
    animation: fade-up 0.7s var(--ease-out-expo) forwards;
    animation-delay: calc(var(--i) * 80ms + 200ms);
  }

  .hero-title {
    margin: 0;
  }

  .hero-body {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(1.6rem, 3.2vw, 2.6rem);
    align-items: center;
  }

  .hero-copy {
    display: grid;
    gap: 0;
    align-content: center;
  }

  .hero-sub {
    max-width: 38rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.15rem;
  }

  .hero-support {
    margin-top: 1.6rem;
    color: var(--color-subtle);
  }

  .hero-proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.8rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--color-line);
    max-width: 30rem;
  }

  .proof-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.1rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .proof-list li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .proof-list li::before {
    content: "";
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-cyan);
    opacity: 0.8;
  }

  .hero-visual {
    position: relative;
  }

  /* WebGL field: sits behind the ambient layer and fades in once the shader
     is compiled, so a failed context leaves the CSS aurora untouched. */
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 1.4s ease;
  }

  .hero-canvas[data-gl-ready="true"] {
    opacity: 1;
  }

  .hero:has(.hero-canvas[data-gl-ready="true"]) .ambient {
    opacity: 0.45;
  }

  .console-slot {
    max-width: 30rem;
    margin-inline: auto;
  }

  .chip-a {
    animation: float-a 7s ease-in-out infinite;
  }

  .chip-b {
    animation: float-b 8s ease-in-out infinite;
  }

  .chip-c {
    animation: float-a 9s ease-in-out infinite;
    animation-delay: -3s;
  }

  @keyframes float-a {
    0%,
    100% {
      transform: translate3d(calc(var(--mx, 0) * 1px), calc(var(--my, 0) * 1px), 0);
    }
    50% {
      transform: translate3d(calc(var(--mx, 0) * 1px), calc(var(--my, 0) * 1px - 10px), 0);
    }
  }

  @keyframes float-b {
    0%,
    100% {
      transform: translate3d(calc(var(--mx, 0) * 1px), calc(var(--my, 0) * 1px), 0);
    }
    50% {
      transform: translate3d(calc(var(--mx, 0) * 1px + 6px), calc(var(--my, 0) * 1px + 8px), 0);
    }
  }

  @media (min-width: 1024px) {
    .hero-body {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(2rem, 4vw, 3.5rem);
    }

    .console-slot {
      margin-inline: 0;
      margin-left: auto;
    }
  }
</style>

<script>
  import "../../scripts/hero-gl";
</script>

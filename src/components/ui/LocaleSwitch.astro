---
import type { Locale } from "../../i18n";
import { pathFor } from "../../data/site";

interface Props {
  locale: Locale;
  label: string;
  class?: string;
  /** Override the home links when the switch stays on another page. */
  ptHref?: string;
  enHref?: string;
}

const {
  locale,
  label,
  class: className = "",
  ptHref = pathFor("pt-BR"),
  enHref = pathFor("en"),
} = Astro.props;
---

<div class:list={["lang-switch", className]} role="group" aria-label={label} data-locale-switch>
  <a
    href={ptHref}
    aria-current={locale === "pt-BR" ? "true" : "false"}
    hreflang="pt-BR"
    lang="pt-BR"
    data-locale-link
  >PT</a>
  <a
    href={enHref}
    aria-current={locale === "en" ? "true" : "false"}
    hreflang="en"
    lang="en"
    data-locale-link
  >EN</a>
</div>

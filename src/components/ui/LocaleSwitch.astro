---
import type { Locale } from "../../i18n";

interface Props {
  locale: Locale;
  label: string;
  class?: string;
}

const { locale, label, class: className = "" } = Astro.props;
---

<div class:list={["lang-switch", className]} role="group" aria-label={label}>
  <a href="/" aria-current={locale === "pt-BR" ? "true" : "false"} hreflang="pt-BR" lang="pt-BR">PT</a>
  <a href="/en/" aria-current={locale === "en" ? "true" : "false"} hreflang="en" lang="en">EN</a>
</div>

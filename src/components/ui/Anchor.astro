---
/**
 * Empty target for the English slug of a section.
 * The Portuguese id on the section stays canonical. The alias is what the
 * English navigation links to (`/en/#work`, `/en/#contact`, …) and what keeps
 * older shared links working.
 */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span id={name} class="anchor-alias" aria-hidden="true"></span>

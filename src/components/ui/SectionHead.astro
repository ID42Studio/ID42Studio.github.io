---
interface Props {
  index?: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  align?: "left" | "center";
  class?: string;
}

const { index, eyebrow, title, subtitle, align = "left", class: className = "" } = Astro.props;
---

<header class:list={["section-head", `is-${align}`, className]} data-reveal>
  <p class="eyebrow">
    {index && <span class="idx">{index}</span>}
    <span>{eyebrow}</span>
  </p>
  <h2 class="display-2 section-title">{title}</h2>
  {subtitle && <p class="lead section-sub">{subtitle}</p>}
</header>

<style>
  .section-head {
    display: grid;
    gap: 1.15rem;
    max-width: 62rem;
  }

  .is-center {
    justify-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .section-title {
    max-width: 20ch;
  }

  .is-center .section-title {
    max-width: 24ch;
  }

  .section-sub {
    max-width: 48ch;
  }
</style>
